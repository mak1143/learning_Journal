# Copy this file to .env and set your own secret key.
# Generate one with:
#   uv run python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=""

# --- Dev defaults (optional, uncomment to override) ---

# Development: DEBUG is on. Production (on the server): set to False.
# DJANGO_DEBUG=False

# Production only: comma-separated hostnames Django is allowed to serve.
# DJANGO_ALLOWED_HOSTS=your-username.pythonanywhere.com